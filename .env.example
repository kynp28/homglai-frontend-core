# URL ของ backend (ไม่มี / ปิดท้าย)
# ตอนพัฒนาบนเครื่อง: ใช้ backend บน Railway หรือ http://localhost:4000 ถ้ารัน backend เอง
NEXT_PUBLIC_API_URL=https://homglai-service-core-production.up.railway.app

# ยอดรวมใบงาน (บาท) ที่ต้องโทรยืนยันราคา — ใช้แสดงคำแนะนำในหน้าเว็บ ต้องตรงกับ PRICE_APPROVAL_THRESHOLD ของ backend
NEXT_PUBLIC_PRICE_APPROVAL_THRESHOLD=1000
